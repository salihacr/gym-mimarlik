# Cloudflare Pages → Settings → Variables and Secrets. Build-time values are
# baked into the static pages; runtime values are read by functions/api/iletisim.ts.
# Set the contact values for BOTH build and runtime (Pages uses the same list).

# Confirm the public HTTPS origin before building the production site.
SITE_URL=
# Development only. Set false to preview the empty production catalogue locally.
SHOW_DEMO=true
# Approved studio contact channels. WhatsApp uses international digits only.
STUDIO_EMAIL=
STUDIO_PHONE=
STUDIO_WHATSAPP=
# Both HTTPS URLs are required for online submission.
PRIVACY_NOTICE_URL=
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Optional Cloudflare Turnstile spam check (both or neither).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Cloudflare Pages build: Node version matching package.json engines.
NODE_VERSION=22.18.0
