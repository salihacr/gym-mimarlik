# Confirm the public HTTPS origin before building the production site.
SITE_URL=
# Development only. Set false to preview the empty production catalogue locally.
SHOW_DEMO=true
# Approved studio contact channels. WhatsApp uses international digits only.
STUDIO_EMAIL=
STUDIO_PHONE=
STUDIO_WHATSAPP=
# Both HTTPS URLs are required for online submission.
PRIVACY_NOTICE_URL=
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Optional, only behind a proxy that replaces this header.
TRUSTED_CLIENT_IP_HEADER=
